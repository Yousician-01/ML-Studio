# All values are optional. Defaults use the platform's user-data directory.
MLSTUDIO_APP_NAME=ML Studio
MLSTUDIO_ENVIRONMENT=development
MLSTUDIO_API_PREFIX=/api/v1
MLSTUDIO_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Maximum CSV source bytes (50 MiB); multipart overhead is bounded separately.
MLSTUDIO_MAX_CSV_UPLOAD_BYTES=52428800
# Local execution bounds; these are operational limits, not a security sandbox.
MLSTUDIO_RUN_TIMEOUT_SECONDS=1800
MLSTUDIO_RUN_LOG_BYTES=10485760
MLSTUDIO_RUN_RESULT_BYTES=1048576
MLSTUDIO_RUN_MODEL_BYTES=1073741824
MLSTUDIO_RUN_DISK_RESERVE_BYTES=67108864
MLSTUDIO_RUN_TERMINATION_GRACE_SECONDS=5
# MLSTUDIO_HOME=/absolute/path/outside/the/repository
# MLSTUDIO_DATABASE_URL=sqlite+pysqlite:////absolute/path/mlstudio.db
