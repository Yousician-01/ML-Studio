{
  "name": "mlstudio-frontend",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "prepare-editor": "node scripts/prepare-editor.mjs",
    "postinstall": "npm run prepare-editor",
    "predev": "npm run prepare-editor",
    "prebuild": "npm run prepare-editor",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "monaco-editor": "0.57.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "monaco-editor": { "dompurify": "3.4.17" }
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "6.0.3"
  }
}
